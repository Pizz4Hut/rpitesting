[Unit]
Description=Raspberry Pi IoT Telemetry Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-client
ExecStart=/usr/bin/python3 /home/pi/pi-client/pi_agent.py --config /home/pi/pi-client/config.json
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
